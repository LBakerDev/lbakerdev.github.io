---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Metric from '../components/Metric.astro';
import Contact from '../components/Contact.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, company, year, role, summary, metrics, stack, cover, coverAlt, links } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article class="case">
    <header class="container head">
      <a class="back" href="/#work">← All work</a>
      <span class="eyebrow">{company} · {year} · {role}</span>
      <h1>{title}</h1>
      <p class="lead muted">{summary}</p>

      {
        metrics.length > 0 && (
          <div class="metrics">
            {metrics.map((m) => (
              <Metric value={m.value} label={m.label} />
            ))}
          </div>
        )
      }

      <ul class="tags" aria-label="Tech stack">
        {stack.map((s) => <li class="tag">{s}</li>)}
      </ul>

      {
        (links.demo || links.repo) && (
          <div class="links">
            {links.demo && (
              <a class="btn btn-primary" href={links.demo} data-goatcounter-click={`demo-${entry.id}`}>
                Try the live demo ↗
              </a>
            )}
            {links.repo && (
              <a class="btn btn-outline" href={links.repo} data-goatcounter-click={`repo-${entry.id}`}>
                Read the code ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="container">
      {
        cover ? (
          <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[800, 1280, 1920]} sizes="100vw" loading="eager" />
        ) : (
          <div class="placeholder cover">[Hero screenshot · 16:9]</div>
        )
      }
    </div>

    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
  <Contact />
</BaseLayout>

<style>
  .case {
    padding-bottom: var(--section-y);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
  }

  .back {
    font-size: 0.9375rem;
    text-decoration: none;
  }

  h1 {
    max-width: 1000px;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .lead {
    max-width: 720px;
    font-size: var(--text-lead);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    padding-block: 24px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .prose {
    max-width: 720px;
    margin-inline: auto;
    padding-top: var(--section-y);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    line-height: 1.15;
    margin: 2.2em 0 0.6em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin-block: 2em;
  }

  .prose :global(blockquote) {
    margin: 2em 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
</style>
