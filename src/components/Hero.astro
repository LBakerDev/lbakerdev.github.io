---
import { site } from '../data/site';
---

<section id="top" class="hero container">
  {
    site.availability.open && (
      <p class="status">
        <span class="pulse-dot" aria-hidden="true" />
        <span class="long">{site.availability.label}</span>
        <span class="short">{site.availability.shortLabel}</span>
      </p>
    )
  }

  <h1>
    Senior frontend engineer building <em>clear, fast</em> data products in React &amp; TypeScript.
  </h1>

  <p class="lead">
    I build the screens people use to make sense of their numbers. Most recently that meant
    reporting for email, SMS and WhatsApp at Mailchimp, used by 2.4 million people a month.
  </p>

  <div class="actions">
    <a class="btn btn-primary" href="#work">
      View selected work
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"></path>
      </svg>
    </a>
    <a class="btn btn-outline" href={site.links.github} rel="me" data-goatcounter-click="github-hero">GitHub ↗</a>
    <a class="social" href={site.links.linkedin} rel="me" data-goatcounter-click="linkedin-hero">LinkedIn ↗</a>
  </div>
</section>

<style>
  /* Kept compact on purpose, so the selected work starts close to the first screen. */
  .hero {
    padding-block: clamp(40px, 5vw, 72px) clamp(40px, 4.5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 32px);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .short {
    display: none;
  }

  h1 {
    max-width: 1120px;
    font-size: var(--text-hero);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  h1 em {
    font-style: normal;
    color: var(--color-accent);
  }

  .lead {
    max-width: 760px;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  /* A quiet text link, without the underline, beside the buttons. */
  .social {
    margin-left: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }

  .social:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .social {
      margin-left: 0;
      text-align: center;
      padding-top: 8px;
    }
  }
</style>
