---
import { site } from '../data/site';
import Pipeline from './Pipeline.astro';
---

<section id="top" class="hero container">
  {
    site.availability.open && (
      <p class="status">
        <span class="pulse-dot" aria-hidden="true" />
        <span class="long">{site.availability.label}</span>
        <span class="short">{site.availability.shortLabel}</span>
      </p>
    )
  }

  <h1>
    Senior software engineer building <em>clear, fast</em> data products in React &amp; TypeScript.
  </h1>

  <div class="row">
    <div class="copy">
      <p class="lead">
        I build the screens people use to make sense of their numbers, most recently email, SMS
        and WhatsApp reporting at Mailchimp, a platform with 2.4 million monthly users.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="#work">
          View selected work
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4"></path>
          </svg>
        </a>
        <a class="btn btn-outline" href={site.links.github} rel="me" data-goatcounter-click="github-hero">GitHub ↗</a>
      </div>

      <p class="previously">
        <span class="label">Previously at</span>
        {site.previously.map((name) => <span class="company">{name}</span>)}
      </p>
    </div>

    <Pipeline />
  </div>
</section>

<style>
  /* Kept compact on purpose, so the selected work starts close to the first screen. */
  .hero {
    padding-block: clamp(40px, 5vw, 72px) clamp(40px, 4.5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 32px);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .short {
    display: none;
  }

  h1 {
    max-width: 1120px;
    font-size: var(--text-hero);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  h1 em {
    font-style: normal;
    color: var(--color-accent);
  }

  /* Text and actions on the left; the pipeline panel fills the space on the right. */
  .row {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      gap: clamp(40px, 5vw, 80px);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  .lead {
    max-width: 640px;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  /* A quiet text link, without the underline, beside the buttons. */

  /* "Previously at": the portfolio version of a logo row. */
  .previously {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--color-muted);
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .company {
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
