---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Metric from './Metric.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  variant?: 'featured' | 'standard';
}

const { entry, variant = 'standard' } = Astro.props;
const { title, company, year, summary, metrics, stack, cover, coverAlt, links } = entry.data;
const href = `/work/${entry.id}/`;
const featured = variant === 'featured';
// Short name for link labels: "Meridian" from "Meridian: goal-based investing…".
const shortName = title.split(':')[0];
---

<article class:list={['card', variant]}>
  <div class="media">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={featured ? [640, 960, 1280] : [480, 720, 960]}
          sizes={featured ? '(min-width: 960px) 55vw, 100vw' : '(min-width: 768px) 45vw, 100vw'}
          loading={featured ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="placeholder">[Screenshot · 16:10]</div>
      )
    }
    {
      featured && links?.demo && (
        <div class="live-layer">
          <a class="live" href={links.demo} target="_blank" rel="noopener" aria-label={`${shortName} live demo (opens in a new tab)`} data-goatcounter-click={`demo-card-${entry.id}`}>
            <span class="live-dot" aria-hidden="true" />
            Live demo ↗
          </a>
        </div>
      )
    }
  </div>

  <div class="body">
    <span class:list={['meta', { accent: entry.data.featured }]}>
      {entry.data.featured && 'Featured · '}{company} · {year}
    </span>
    <h3><a href={href} data-goatcounter-click={`card-${entry.id}`}>{title}</a></h3>
    <p class="muted">{summary}</p>

    {
      featured && metrics.length > 0 && (
        <div class="metrics">
          {metrics.slice(0, 2).map((m) => (
            <Metric value={m.value} label={m.label} />
          ))}
        </div>
      )
    }

    {
      featured ? (
        <ul class="tags" aria-label="Tech stack">
          {stack.map((s) => (
            <li class="tag">{s}</li>
          ))}
        </ul>
      ) : null
    }

    <div class="footer">
      {!featured && <span class="stack">{stack.join(' · ')}</span>}
      <a class="more" href={href} aria-hidden="true" tabindex="-1">
        {featured ? 'Read the case study →' : 'Case study →'}
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }




  .media :global(img),
  .media .placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    color: var(--color-muted);
  }

  .meta.accent {
    color: var(--color-accent);
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--text-h3);
    line-height: 1.15;
  }

  /* Whole card is clickable via the title link; the visible "Case study →" is decorative. */
  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .card:has(h3 a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .metrics {
    display: flex;
    gap: 32px;
    padding-block: 20px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: auto;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .more {
    font-weight: 500;
    white-space: nowrap;
  }

  /* The live demo, as a pill on the cover. It sits above the card-wide link, so
     it opens the demo rather than the case study.
     A status badge in the cover's top margin (11.5% of the image's height),
     lined up with the app window's right edge (5% in), well away from the
     "Read the case study" link. It scales with the
     image (cqi), so it fits the margin at any width. */
  .media {
    position: relative;
  }

  /* An invisible layer over the cover that the pill measures itself against.
     Absolutely positioned, so the measuring can't change the card's layout. */
  .live-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    container-type: inline-size;
    pointer-events: none;
  }

  .live {
    position: absolute;
    pointer-events: auto;
    right: 5%;
    top: 5.75%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1em;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.85);
    color: #fff;
    font-family: var(--font-mono);
    font-size: clamp(10px, 2.2cqi, 13px);
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .live:hover {
    background: #111;
  }

  .live:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* On small covers, a smaller pill so it still fits the margin. */
  @container (max-width: 400px) {
    .live {
      font-size: 9px;
    }
  }

  .live-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.25);
  }


  /* Featured: image left, text right on wide screens */
  .featured {
    padding: clamp(16px, 2.2vw, 32px);
  }

  .featured h3 {
    font-size: var(--text-h3-lg);
    line-height: 1.1;
  }

  @media (min-width: 960px) {
    .featured {
      flex-direction: row;
      gap: 56px;
    }

    .featured .media {
      flex: 1 1 0;
      min-width: 0;
    }

    .featured .media {
      align-self: center;
    }

    /* Keep the cover at its natural 16:10 shape so nothing gets cropped. */
    .featured .media :global(img),
    .featured .media .placeholder {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .featured .body {
      width: 420px;
      flex-shrink: 0;
      padding: 16px 8px;
      gap: 20px;
    }
  }
</style>
