---
import SectionHeading from './SectionHeading.astro';
import { toolkit } from '../data/experience';
---

<section class="section" aria-labelledby="toolkit-title">
  <div class="container split">
    <div class="aside">
      <SectionHeading id="toolkit-title" eyebrow="03 — Toolkit" title="What I work with" />
    </div>
    <div class="groups">
      {
        toolkit.map((g) => (
          <div class="group">
            <h3>{g.group}</h3>
            <ul>
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .split {
    display: flex;
    gap: clamp(20px, 5.5vw, 80px);
  }

  .aside {
    width: 360px;
    flex-shrink: 0;
  }

  .groups {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  h3 {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 14px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.9;
    color: var(--color-muted);
  }

  @media (max-width: 959px) {
    .split {
      flex-direction: column;
    }

    .aside {
      width: auto;
    }
  }

  @media (max-width: 599px) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
