---
// To add a portrait: put it in src/assets/ and swap the placeholder for
// <Image src={portrait} alt="…" /> from 'astro:assets'.
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container split">
    <div class="placeholder portrait">[Portrait · 4:5]</div>
    <div class="text">
      <span class="eyebrow">04 — About</span>
      <h2 id="about-title" class="visually-hidden">About me</h2>
      <p class="statement">
        [A human sentence about how you work — what you care about in the craft.]
      </p>
      <p class="muted">
        [Short paragraph: background, what you're looking for next, one detail outside work. Keep
        it to 3–4 sentences.]
      </p>
    </div>
  </div>
</section>

<style>
  .split {
    display: flex;
    align-items: center;
    gap: clamp(20px, 5.5vw, 80px);
  }

  .portrait {
    width: 360px;
    flex-shrink: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
  }

  .text {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.2;
  }

  .muted {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  @media (max-width: 767px) {
    .split {
      flex-direction: column;
      align-items: stretch;
    }

    .portrait {
      width: 100%;
      aspect-ratio: 4 / 3;
    }
  }
</style>
