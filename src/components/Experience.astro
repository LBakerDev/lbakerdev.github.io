---
import SectionHeading from './SectionHeading.astro';
import { experience, earlier } from '../data/experience';
import { site } from '../data/site';
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container split">
    <div class="aside">
      <SectionHeading id="experience-title" eyebrow="02 — Experience" title="Where I've shipped" />
    </div>
    <ol class="roles">
      {
        experience.map((role) => (
          <li>
            <span class="dates">
              {role.start} — {role.end}
            </span>
            <div class="role">
              <span class="title">
                <span class="company">{role.company}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span class="position">{role.title}</span>
              </span>
              <span class="muted">{role.summary}</span>
              {role.caseStudy && (
                <a class="case-link" href={role.caseStudy}>
                  Read the case study →
                </a>
              )}
            </div>
          </li>
        ))
      }
      <li class="earlier">
        <span class="dates">{earlier.years}</span>
        <div class="role">
          <span class="muted">
            {earlier.text} <a href={site.resumeUrl}>Full history in my résumé →</a>
          </span>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .split {
    display: flex;
    gap: clamp(20px, 5.5vw, 80px);
  }

  .aside {
    width: 360px;
    flex-shrink: 0;
  }

  .roles {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 32px;
    padding-block: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .dates {
    width: 120px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  @media (max-width: 959px) {
    .split {
      flex-direction: column;
    }

    .aside {
      width: auto;
    }
  }

  @media (max-width: 767px) {
    li {
      flex-direction: column;
      gap: 6px;
      padding-block: 18px;
    }

    .title {
      font-size: 1.0625rem;
    }
  }

  .earlier .muted {
    font-size: 0.9375rem;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
  }

  .company {
    font-weight: 600;
  }

  .sep {
    color: var(--color-muted);
    font-weight: 400;
  }

  .position {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .case-link {
    align-self: flex-start;
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
