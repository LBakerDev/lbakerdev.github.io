---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container inner">
    <span class="eyebrow">05 — Contact</span>
    <div class="split">
      <div class="intro">
        <h2 id="contact-title">Hiring for a frontend role? Let's talk.</h2>
        <p class="or">Prefer email?</p>
        <div class="actions">
          <a class="btn btn-ghost" href={`mailto:${site.email}`} data-goatcounter-click="email-mailto">{site.email}</a>
          <button type="button" class="btn btn-ghost copy" data-copy={site.email} data-goatcounter-click="email-copy">
            <span class="copy-label">Copy email</span>
          </button>
          <a class="btn btn-ghost" href={site.resumeUrl} data-goatcounter-click="resume-contact">Download résumé</a>
        </div>
        <p class="local-time">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span data-local-time>Based in Atlanta · Eastern Time</span>
        </p>
      </div>

      <!-- Sends through Web3Forms (no server needed on GitHub Pages). Without
           JavaScript it still posts and Web3Forms shows its own thank-you page;
           with it, the result shows here and nothing reloads. -->
      <form class="form" action="https://api.web3forms.com/submit" method="POST" data-contact-form novalidate>
        <input type="hidden" name="access_key" value={site.contactFormKey} />
        <input type="hidden" name="subject" value="New message from your portfolio" />
        <input type="hidden" name="from_name" value="Portfolio contact form" />
        <!-- Spam trap: hidden from people, filled in by bots. -->
        <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" />
        </div>
        <div class="field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="field wide">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="4" required maxlength="5000"></textarea>
        </div>

        <div class="submit wide">
          <button type="submit" class="btn btn-light">Send message</button>
          <p class="status" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>

    <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    <div class="legal">
      <span>© {year} {site.name} · {site.location}</span>
      <div class="links">
        <a href={site.links.github} rel="me" data-goatcounter-click="github-footer">GitHub</a>
        <a href={site.links.linkedin} rel="me" data-goatcounter-click="linkedin-footer">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .contact {
    background: var(--color-inverse-bg);
    color: var(--color-inverse-ink);
    padding-block: clamp(64px, 9vw, 120px) 32px;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.8vw, 36px);
  }

  .eyebrow {
    color: var(--color-inverse-muted);
  }

  h2 {
    max-width: 1000px;
    font-size: var(--text-contact);
    line-height: 1.02;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn-light {
    background: var(--color-inverse-ink);
    color: var(--color-ink);
  }

  .btn-light:hover {
    background: #fff;
    color: var(--color-ink);
  }

  .btn-ghost {
    border: 1px solid var(--color-inverse-ink);
    color: var(--color-inverse-ink);
  }

  .btn-ghost:hover {
    background: var(--color-inverse-ink);
    color: var(--color-ink);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(24px, 3.5vw, 48px);
    padding-top: 28px;
    border-top: 1px solid var(--color-inverse-line);
    font-size: var(--text-small);
    color: var(--color-inverse-muted);
  }

  .links {
    display: flex;
    gap: 28px;
  }

  .links a {
    color: var(--color-inverse-ink);
  }

  @media (max-width: 767px) {
    .actions {
      flex-direction: column;
    }
  }

  /* Wide screens: heading and direct contact on the left, the form on the
     right, so the section isn't one tall column. */
  .split {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }

    /* The left column is half as wide, so the heading steps down a size to keep its shape. */
    .split h2 {
      font-size: min(var(--text-contact), 4.25rem);
    }
  }

  /* Contact form: name and email side by side when there's room, message full width. */
  .form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px 20px;
  }

  @media (min-width: 768px) {
    .form {
      grid-template-columns: 1fr 1fr;
    }

    .wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: var(--text-small);
    color: var(--color-inverse-muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--color-inverse-line);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-inverse-ink);
    font: inherit;
    transition: border-color 0.15s ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-inverse-ink);
    box-shadow: 0 0 0 1px var(--color-inverse-ink);
  }

  .field [aria-invalid='true'] {
    border-color: #f08a7e;
  }

  .trap {
    position: absolute;
    left: -9999px;
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .submit .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-inverse-muted);
  }

  .status[data-tone='ok'] {
    color: #6fdc9f;
  }

  .status[data-tone='error'] {
    color: #f08a7e;
  }

  .or {
    margin: 4px 0 -12px;
    font-size: var(--text-small);
    color: var(--color-inverse-muted);
  }

  .copy {
    font-family: inherit;
    cursor: pointer;
    background: transparent;
  }

  .copy.done {
    border-color: var(--color-success);
  }

  .local-time {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-small);
    color: var(--color-inverse-muted);
  }

  .local-time .pulse-dot {
    margin-right: 2px;
  }
</style>

<script>
  import { site } from '../data/site';

  // Delight — small, honest, useful.
  // Local time: helps recruiters in other time zones know when a reply is likely.
  const timeEl = document.querySelector<HTMLElement>('[data-local-time]');
  if (timeEl) {
    const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' });
    const update = () => (timeEl.textContent = `It's ${fmt.format(new Date())} in Atlanta`);
    update();
    setInterval(update, 30_000);
  }

  // Contact form: checks fields, sends to Web3Forms, and reports the result in
  // place. What was typed is kept if sending fails, so it can be sent again.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const formStatus = document.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!formStatus) return;
    const say = (text: string, tone?: 'ok' | 'error') => {
      formStatus.textContent = text;
      if (tone) formStatus.dataset.tone = tone;
      else delete formStatus.dataset.tone;
    };

    // Check before sending: mark the empty or malformed fields and focus the first.
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]):not(.trap), textarea')];
    fields.forEach((f) => f.setAttribute('aria-invalid', String(!f.checkValidity())));
    const firstBad = fields.find((f) => !f.checkValidity());
    if (firstBad) {
      say(firstBad.type === 'email' && firstBad.value ? 'Check the email address.' : 'Please fill in every field.', 'error');
      firstBad.focus();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (button) button.disabled = true;
    say('Sending…');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) throw new Error(result.message);
      form.reset();
      fields.forEach((f) => f.removeAttribute('aria-invalid'));
      say("Thanks, your message is on its way. I'll reply within a day or two.", 'ok');
      (window as { goatcounter?: { count: (o: object) => void } }).goatcounter?.count({ path: 'contact-form-sent', title: 'Contact form sent', event: true });
    } catch {
      say(`That didn't send. Try again, or email ${site.email}.`, 'error');
    } finally {
      if (button) button.disabled = false;
    }
  });
  form?.addEventListener('input', (event) => {
    const field = event.target as HTMLInputElement;
    if (field.getAttribute('aria-invalid') === 'true' && field.checkValidity()) field.setAttribute('aria-invalid', 'false');
  });

  // Copy email: one click, confirmed in place, then quietly resets.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('.copy-label');
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      if (label) label.textContent = 'Copied ✓';
      if (status) status.textContent = 'Email address copied to clipboard';
      btn.classList.add('done');
      setTimeout(() => {
        if (label) label.textContent = 'Copy email';
        btn.classList.remove('done');
        if (status) status.textContent = '';
      }, 2000);
    } catch {
      if (label) label.textContent = 'Press ⌘C to copy';
    }
  });
</script>
