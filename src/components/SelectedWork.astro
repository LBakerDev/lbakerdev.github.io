---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import CaseStudyCard from './CaseStudyCard.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = entries.find((e) => e.data.featured) ?? entries[0];
const rest = entries.filter((e) => e !== featured);
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container stack">
    <div class="intro">
      <SectionHeading id="work-title" eyebrow="01 — Selected work" title="Case studies" />
    </div>

    {featured && <CaseStudyCard entry={featured} variant="featured" />}

    {
      rest.length === 1 ? (
        <CaseStudyCard entry={rest[0]} variant="featured" />
      ) : (
        rest.length > 1 && (
          <div class="grid">
            {rest.map((entry) => (
              <CaseStudyCard entry={entry} />
            ))}
          </div>
        )
      )
    }
  </div>
</section>

<style>
  /* Starts closer to the hero than other sections, so the first case study
     shows on (or near) the first screen. */
  .work {
    padding-top: clamp(40px, 4.5vw, 64px);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }

  .intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
